        {
          "name": "GetVehicle (full detail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetVehicle($id: UUID!) {\n  vehicle(id: $id) {\n    vehicle {\n      id\n      vin\n      model\n      manufacturer\n      year\n      currentLocationId\n      batteryStatusId\n      lastTripId\n    }\n    locations {\n      id\n      vehicleId\n      latitude\n      longitude\n      speed\n      timestamp\n    }\n    battery {\n      id\n      vehicleId\n      percentage\n      voltage\n      temperature\n      isCharging\n      timestamp\n    }\n    trips {\n      id\n      vehicleId\n      startTime\n      endTime\n      distanceKm\n      averageSpeed\n      fuelConsumed\n      energyConsumed\n      startLocationId\n      endLocationId\n    }\n    telemetry {\n      id\n      vehicleId\n      type\n      value\n      timestamp\n    }\n    alerts {\n      id\n      vehicleId\n      type\n      message\n      isResolved\n      createdAt\n    }\n  }\n}",
                "variables": "{\n  \"id\": \"{{vehicleId}}\"\n}"
              }
            }
          }
        },

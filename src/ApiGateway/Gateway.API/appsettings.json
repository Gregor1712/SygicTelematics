{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TokenKey": "this-is-a-super-secret-key-that-must-be-at-least-64-characters-long-for-hmac-sha512",
  "ServiceUrls": {
    "Identity": "http://localhost:5101"
  },
  "GrpcUrls": {
    "Vehicle": "https://localhost:7103",
    "Location": "https://localhost:7104",
    "Battery": "https://localhost:7105",
    "Trip": "https://localhost:7106",
    "Telemetry": "https://localhost:7107",
    "Alert": "https://localhost:7108"
  },
  "ReverseProxy": {
    "Routes": {
      "location-get": {
        "ClusterId": "location",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/locations/vehicle/{vehicleId}"
        },
        "Transforms": [
          { "PathPattern": "api/locations/vehicle/{vehicleId}" }
        ]
      },
      "location-post": {
        "ClusterId": "location",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/locations",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "api/locations" }
        ]
      },
      "battery-get": {
        "ClusterId": "battery",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/battery/vehicle/{vehicleId}"
        },
        "Transforms": [
          { "PathPattern": "api/battery/vehicle/{vehicleId}" }
        ]
      },
      "battery-post": {
        "ClusterId": "battery",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/battery",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "api/battery" }
        ]
      },
      "trip-get": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/trips/vehicle/{vehicleId}"
        },
        "Transforms": [
          { "PathPattern": "api/trips/vehicle/{vehicleId}" }
        ]
      },
      "trip-post": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/trips",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "api/trips" }
        ]
      },
      "telemetry-get": {
        "ClusterId": "telemetry",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/telemetry/vehicle/{vehicleId}"
        },
        "Transforms": [
          { "PathPattern": "api/telemetry/vehicle/{vehicleId}" }
        ]
      },
      "telemetry-post": {
        "ClusterId": "telemetry",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/telemetry",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "api/telemetry" }
        ]
      },
      "alert-get": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "api/bff/alerts/vehicle/{vehicleId}"
        },
        "Transforms": [
          { "PathPattern": "api/alerts/vehicle/{vehicleId}" }
        ]
      }
    },
    "Clusters": {
      "location": {
        "Destinations": {
          "default": { "Address": "http://localhost:5104" }
        }
      },
      "battery": {
        "Destinations": {
          "default": { "Address": "http://localhost:5105" }
        }
      },
      "trip": {
        "Destinations": {
          "default": { "Address": "http://localhost:5106" }
        }
      },
      "telemetry": {
        "Destinations": {
          "default": { "Address": "http://localhost:5107" }
        }
      },
      "alert": {
        "Destinations": {
          "default": { "Address": "http://localhost:5108" }
        }
      }
    }
  }
}
